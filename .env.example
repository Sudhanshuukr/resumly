# ============================================================
# Resume AI — Environment Variables Example
# ============================================================

# Required: Your Groq API key
# Get a FREE key at https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# AI Provider
AI_PROVIDER=groq

# Model to use — llama-3.3-70b-versatile is fast, free-tier friendly, great at JSON
# Other options: llama-3.1-8b-instant (faster), mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Maximum file upload size in bytes (default: 10 MB)
MAX_UPLOAD_SIZE=10485760

# Maximum resume text characters sent to the AI (default: 25,000)
MAX_RESUME_CHARACTERS=25000

# Rate limiting (set to 0 to disable — disabled by default)
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=60000

# Supabase Configuration
# Replace these with your actual Supabase project URL and anon/public key.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
# REQUIRED FOR BACKEND: Get this service role key from your Supabase Dashboard -> Settings -> API.
# Keep this secret. Do NOT prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
