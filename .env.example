# ============================================================
# Resume AI — Environment Variables Example
# ============================================================

# Required: Your Groq API key
# Get a FREE key at https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# AI Provider
AI_PROVIDER=groq

# Model to use — openai/gpt-oss-120b is fast, powerful, and excellent at JSON generation
# Other supported options on Groq: openai/gpt-oss-20b (faster/lighter), groq/compound-mini
GROQ_MODEL=openai/gpt-oss-120b

# Maximum file upload size in bytes (default: 10 MB)
MAX_UPLOAD_SIZE=10485760

# Maximum resume text characters sent to the AI (default: 25,000)
MAX_RESUME_CHARACTERS=25000

# Rate limiting (set to 0 to disable — disabled by default)
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=60000

# Supabase Configuration
# Replace these with your actual Supabase project URL and anon/public key.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
# REQUIRED FOR BACKEND: Get this service role key from your Supabase Dashboard -> Settings -> API.
# Keep this secret. Do NOT prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
